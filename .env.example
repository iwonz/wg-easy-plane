# Copy to an ignored local .env file and replace every placeholder.
APP_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
DATABASE_PATH=<absolute-path-outside-the-repository>
SYNC_INTERVAL_SECONDS=300
NODE_REQUEST_TIMEOUT_MS=10000
# Exact trusted browser origin used for Origin/CSRF validation (no path).
PANEL_PUBLIC_URL=http://localhost:3000
SUBSCRIPTION_PUBLIC_URL=http://localhost:3001
CONTROL_PLANE_INTERNAL_URL=http://localhost:3000
