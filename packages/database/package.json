{
  "name": "@wg-easy-plane/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "tsc --outDir dist --declaration --emitDeclarationOnly --noEmit false",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/migrate-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wg-easy-plane/config": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
