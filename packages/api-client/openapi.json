{
  "openapi": "3.1.0",
  "info": {
    "title": "WG Easy Plane API",
    "version": "0.0.0",
    "description": "Typed API for the WG Easy Plane control plane."
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wgep_access"
      },
      "refreshCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wgep_refresh"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "wgep_pat_*"
      },
      "subscriptionSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "wgep_subscription"
      }
    },
    "schemas": {
      "CursorQuery": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["nextCursor"]
      },
      "SystemStatus": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["wg-easy-plane"]
          },
          "version": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string",
            "enum": ["v1"]
          },
          "supportedWgEasyVersion": {
            "type": "string",
            "enum": ["15.4.0"]
          }
        },
        "required": ["name", "version", "apiVersion", "supportedWgEasyVersion"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": ["code", "message", "requestId"]
          }
        },
        "required": ["error"]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHORIZED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VALIDATION_ERROR",
          "RATE_LIMITED",
          "UPSTREAM_ERROR",
          "INTERNAL_ERROR"
        ]
      },
      "SetupStatus": {
        "type": "object",
        "properties": {
          "setupRequired": {
            "type": "boolean"
          }
        },
        "required": ["setupRequired"]
      },
      "AuthenticatedAdmin": {
        "type": "object",
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/PublicAdmin"
          }
        },
        "required": ["admin"]
      },
      "PublicAdmin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,64}$",
            "description": "Lowercase administrator username",
            "example": "panel-admin"
          }
        },
        "required": ["id", "username"]
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-z0-9._-]{3,64}$",
            "description": "Lowercase administrator username",
            "example": "panel-admin"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "Administrator password; never returned by the API"
          }
        },
        "required": ["username", "password"],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["username", "password"],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/system/status": {
      "get": {
        "tags": ["System"],
        "summary": "Read public control-plane compatibility status",
        "responses": {
          "200": {
            "description": "Control-plane status",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup/status": {
      "get": {
        "operationId": "getSetupStatus",
        "tags": ["Authentication"],
        "summary": "Read first-run setup state",
        "responses": {
          "200": {
            "description": "Current setup state",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "operationId": "setupAdmin",
        "tags": ["Authentication"],
        "summary": "Create the only administrator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Administrator created",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAdmin"
                }
              }
            }
          },
          "400": {
            "description": "Invalid setup request",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Untrusted request origin",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Administrator setup is already complete",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Authentication attempt limit exceeded",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "description": "Seconds until another attempt is allowed"
                },
                "required": true,
                "description": "Seconds until another attempt is allowed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginAdmin",
        "tags": ["Authentication"],
        "summary": "Start an administrator browser session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Administrator authenticated",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAdmin"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login request",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid username or password",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Untrusted request origin",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Authentication attempt limit exceeded",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "description": "Seconds until another attempt is allowed"
                },
                "required": true,
                "description": "Seconds until another attempt is allowed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshAdminSession",
        "tags": ["Authentication"],
        "summary": "Rotate the administrator refresh session",
        "security": [
          {
            "refreshCookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Session rotated",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            }
          },
          "401": {
            "description": "Refresh session is invalid or has been reused",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Untrusted request origin",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Authentication attempt limit exceeded",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              },
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "description": "Seconds until another attempt is allowed"
                },
                "required": true,
                "description": "Seconds until another attempt is allowed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutAdmin",
        "tags": ["Authentication"],
        "summary": "End the administrator browser session",
        "security": [
          {
            "refreshCookieAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Cookies cleared and identifiable session revoked",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            }
          },
          "403": {
            "description": "Untrusted request origin",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentAdmin",
        "tags": ["Authentication"],
        "summary": "Read the authenticated administrator",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current administrator",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedAdmin"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Request correlation identifier"
                },
                "required": true,
                "description": "Request correlation identifier"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
